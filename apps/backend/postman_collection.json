        {
            "name": "5. Interview Sessions",
            "item": [
                {
                    "name": "Create Session",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/sessions",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "sessions"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"topicId\": \"<TOPIC_ID>\",\n    \"mode\": \"ONE_ON_ONE_AI\",\n    \"interviewLevel\": \"SCREENING\",\n    \"difficulty\": \"INTERMEDIATE\",\n    \"adaptive\": true,\n    \"durationMinutes\": 30\n}"
                        }
                    }
                },
                {
                    "name": "List Your Sessions",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/sessions?page=1&limit=10&status=COMPLETED",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "sessions"
                            ],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "10"
                                },
                                {
                                    "key": "status",
                                    "value": "COMPLETED"
                                }
                            ]
                        }
                    }
                },
