        {
            "name": "4. Question Bank",
            "item": [
                {
                    "name": "Create Question in Bank",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/question-bank",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "question-bank"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"content\": \"Tell me about a time you had to deal with a severe production outage.\",\n    \"topicId\": \"<TOPIC_ID>\",\n    \"difficulty\": \"ADVANCED\",\n    \"questionType\": \"behavioral\",\n    \"isGlobal\": false\n}"
                        }
                    }
                },
                {
                    "name": "List Bank Questions",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/question-bank?topicId=<TOPIC_ID>&difficulty=ADVANCED",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "question-bank"
                            ],
                            "query": [
                                {
                                    "key": "topicId",
                                    "value": "<TOPIC_ID>"
                                },
                                {
                                    "key": "difficulty",
                                    "value": "ADVANCED"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Bank Question by ID",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/question-bank/<QUESTION_BANK_ID>",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "question-bank",
                                "<QUESTION_BANK_ID>"
                            ]
                        }
                    }
                }
