                                "{{baseUrl}}"
                            ],
                            "path": [
                                "identity",
                                "skill-tags"
                            ]
                        }
                    }
                },
                {
                    "name": "Add/Update Skill Preference",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/identity/me/skills",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "identity",
                                "me",
                                "skills"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"skillTagId\": \"<SKILL_TAG_ID>\",\n    \"level\": \"INTERMEDIATE\"\n}"
                        }
                    }
                },
                {
                    "name": "Remove Skill Preference",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/identity/me/skills/<SKILL_TAG_ID>",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "identity",
                                "me",
                                "skills",
                                "<SKILL_TAG_ID>"
                            ]
                        }
                    }
                }
            ]
