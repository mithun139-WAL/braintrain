{
    "info": {
        "name": "BrainTrain API",
        "description": "API collection for the BrainTrain backend, covering Auth, Profiles, Sessions, Questions, Evaluation, and Analytics.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Identity & Auth",
            "item": [
                {
                    "name": "Register User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/identity/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "identity",
                                "register"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"Password123\"\n}"
                        }
                    }
                },
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/identity/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "identity",
                                "login"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"Password123\"\n}"
                        }
                    }
                },
                {
                    "name": "Request OTP (Email)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/identity/request-otp",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "identity",
                                "request-otp"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"identifier\": \"test@example.com\"\n}"
                        }
                    }
                },
                {
                    "name": "Verify OTP (Email)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/identity/verify-otp",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "identity",
                                "verify-otp"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"identifier\": \"test@example.com\",\n    \"code\": \"123456\"\n}"
                        }
                    }
                },
                {
                    "name": "Request OTP (SMS)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/identity/request-otp",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "identity",
                                "request-otp"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"identifier\": \"+1234567890\"\n}"
                        }
                    }
                },
                {
                    "name": "Verify OTP (SMS)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/identity/verify-otp",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "identity",
                                "verify-otp"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"identifier\": \"+1234567890\",\n    \"code\": \"123456\"\n}"
                        }
                    }
                },
                {
                    "name": "Google Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/identity/google",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "identity",
                                "google"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"token\": \"<GOOGLE_ID_TOKEN>\"\n}"
                        }
                    }
                }
            ]
        },
        {
            "name": "2. Profile & Skills",
            "item": [
                {
                    "name": "Get My Profile",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/identity/me",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "identity",
                                "me"
                            ]
                        }
                    }
                },
                {
                    "name": "Update Profile",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/identity/me",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "identity",
                                "me"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"displayName\": \"John Doe\",\n    \"bio\": \"Software Engineer\",\n    \"avatarUrl\": \"https://example.com/avatar.jpg\"\n}"
                        }
                    }
                },
                {
                    "name": "List Global Skill Tags",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/identity/skill-tags",
