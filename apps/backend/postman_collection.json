                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/sessions/<SESSION_ID>/complete",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "sessions",
                                "<SESSION_ID>",
                                "complete"
