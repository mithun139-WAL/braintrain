generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  CREATED
  ACTIVE
  COMPLETED
  ANALYZED
  CANCELLED
}

enum EvaluationJobStatus {
  PENDING
  PROCESSING
  FAILED
  COMPLETED
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum InterviewMode {
  ONE_ON_ONE_AI
  GROUP_AI
  HYBRID
}

enum InterviewLevel {
  SCREENING
  TECHNICAL_L1
  TECHNICAL_L2
  HR
  SYSTEM_DESIGN
}

model User {
  id            String   @id @default(uuid())
  email         String?  @unique
  phoneNumber   String?  @unique
  googleId      String?  @unique
  passwordHash  String?
  displayName   String?
  bio           String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  // ── SaaS Plan & Usage Limits (Phase 3) ──
  planType                 String   @default("FREE")  // FREE | PRO
  monthlySessionCount      Int      @default(0)
  monthlyEvaluationCredits Int      @default(0)
  usagePeriodStart         DateTime @default(now())

  sessions          InterviewSession[]
  topics            Topic[]
  contextInputs     UserContextInput[]
  otpCodes          OtpCode[]
  skillPreferences  UserSkillPreference[]
  questionBankItems QuestionBank[]

  // ── Indexes ──
  // email/phoneNumber/googleId already have unique indexes via @unique
  // deletedAt index for soft-delete scans
  @@index([deletedAt])
}

model OtpCode {
  id          String   @id @default(uuid())
  userId      String?
  identifier  String   // email or phone number
  code        String
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  attemptCount Int     @default(0)
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Lookup by identifier + active codes (isUsed=false + not expired)
  @@index([identifier])
  @@index([identifier, isUsed, expiresAt])
}

model SkillTag {
  id              String   @id @default(uuid())
  name            String   @unique
  isGlobal        Boolean  @default(false)
  createdByUserId String?
  createdAt       DateTime @default(now())

  userPreferences UserSkillPreference[]
}

model UserSkillPreference {
  id         String   @id @default(uuid())
  userId     String
  skillTagId String
  level      String   // BEGINNER | INTERMEDIATE | ADVANCED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillTag   SkillTag @relation(fields: [skillTagId], references: [id], onDelete: Cascade)

  @@unique([userId, skillTagId])
}

model Topic {
  id                String   @id @default(uuid())
  name              String
  isGlobal          Boolean  @default(false)
  createdByUserId   String?
  parentTopicId     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@unique([name, isGlobal])

  createdByUser     User?          @relation(fields: [createdByUserId], references: [id])
  parentTopic       Topic?         @relation("Subtopics", fields: [parentTopicId], references: [id])
  subtopics         Topic[]        @relation("Subtopics")
  sessions          InterviewSession[]
  questionBankItems QuestionBank[]

  // List topics for a user: filter by (isGlobal OR createdByUserId) + not deleted
  @@index([isGlobal, deletedAt])
  @@index([createdByUserId, deletedAt])
}

model QuestionBank {
  id              String          @id @default(uuid())
  content         String
  topicId         String
  difficulty      DifficultyLevel
  questionType    String          // "behavioral" | "technical"
  source          String          @default("HUMAN") // "HUMAN" | "GENERATED"
  isGlobal        Boolean         @default(false)
  createdByUserId String?
  usageCount      Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  topic           Topic           @relation(fields: [topicId], references: [id])
  createdByUser   User?           @relation(fields: [createdByUserId], references: [id])

  // Primary lookup: bank-first question selection by topic + difficulty (excludes deleted)
  @@index([topicId, difficulty, deletedAt])
  // Secondary: filter by source (HUMAN vs GENERATED) for analytics
  @@index([source, topicId])
  // Original composite (retained for query compatibility)
  @@index([topicId, difficulty])
}

model InterviewSession {
  id                String           @id @default(uuid())
  userId            String
  topicId           String
  mode              InterviewMode
  interviewLevel    InterviewLevel?  // SCREENING | TECHNICAL_L1 | TECHNICAL_L2 | HR | SYSTEM_DESIGN
  difficulty        DifficultyLevel
  adaptive          Boolean
  durationMinutes   Int
  personalityConfig Json?
  status            SessionStatus
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  user              User              @relation(fields: [userId], references: [id])
  topic             Topic             @relation(fields: [topicId], references: [id])
  questions         QuestionInstance[]
  evaluation        EvaluationReport?
  evaluationJob     EvaluationJob?

  // Hot path: list sessions for a user (filtered by status, not deleted)
  @@index([userId, status, deletedAt])
  // Analytics: sessions by userId ordered by createdAt descending
  @@index([userId, createdAt])
  // Topic-level analytics: all sessions for a topic
  @@index([topicId, userId])
}

model QuestionInstance {
  id            String   @id @default(uuid())
  sessionId     String
  content       String
  difficulty    DifficultyLevel
  sequenceOrder Int
  generatedAt   DateTime @default(now())
  deletedAt     DateTime?

  session       InterviewSession @relation(fields: [sessionId], references: [id])
  responses     ResponseInstance[]

  @@unique([sessionId, sequenceOrder])
  // Load all questions for a session in order (most common query)
  @@index([sessionId, sequenceOrder, deletedAt])
}

model ResponseInstance {
  id                  String   @id @default(uuid())
  questionId          String
  answerText          String?
  audioUrl            String?
  responseTimeMs      Int
  thinkingTimeMs      Int
  answerLength        Int

  // ── PerformanceSignal scores (populated after AI evaluation) ──
  clarityScore        Float?
  structureScore      Float?
  depthScore          Float?
  confidenceScore     Float?
  communicationScore  Float?
  hesitationScore     Float?
  technicalScore      Float?   // null for behavioral questions
  pressureScore       Float?   // 0–100: calm under time pressure
  thinkingDepthScore  Float?   // 0–100: deliberate pre-answer composure
  overallScore        Float?
  evaluationExplanation String?

  createdAt           DateTime @default(now())
  deletedAt           DateTime?

  question            QuestionInstance @relation(fields: [questionId], references: [id])

  @@unique([questionId])
  // Adaptive engine reads overallScore for last N responses — needs fast lookup
  @@index([questionId, overallScore])
}

model EvaluationReport {
  id                         String   @id @default(uuid())
  sessionId                  String   @unique

  // ── Aggregated PerformanceSignal dimensions (averaged across session) ──
  overallScore               Float
  clarityScore               Float
  structureScore             Float
  depthScore                 Float
  confidenceScore            Float
  communicationScore         Float
  hesitationScore            Float
  technicalScore             Float?   // null for behavioral sessions

  // ── Behavioral timing signals (from responseTimeMs / thinkingTimeMs) ──
  pressureScore              Float?   // 0–100: stress indicator from response speed
  thinkingDepthScore         Float?   // 0–100: deliberate pause quality signal

  // ── Cost tracking (Phase 3 — LLM provider) ──
  promptVersion              String?  @default("stub")
  modelUsed                  String?  // e.g. "gpt-4o-mini", "stub"
  inputTokens                Int?
  outputTokens               Int?
  estimatedCostUsd           Float?

  feedbackSummary            String
  improvementSuggestions     Json

  createdAt                  DateTime @default(now())
  deletedAt                  DateTime?

  session                    InterviewSession @relation(fields: [sessionId], references: [id])

  // Analytics: fetch all reports for a user ordered by date (via join on session)
  // sessionId already has @unique — covered.
  // Cross-session trend: order by createdAt
  @@index([createdAt])
  // Cost analytics: find reports by model for billing intelligence
  @@index([modelUsed, createdAt])
}

model EvaluationJob {
  id                     String              @id @default(uuid())
  sessionId              String              @unique
  status                 EvaluationJobStatus @default(PENDING)
  attempts               Int                 @default(0)
  lastError              String?
  nextRetryAt            DateTime?           // null = ready immediately; set for exponential backoff
  evaluationStartedAt    DateTime?
  evaluationCompletedAt  DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  session  InterviewSession @relation(fields: [sessionId], references: [id])

  // Worker claim query: PENDING jobs where nextRetryAt IS NULL or <= now(), oldest first
  @@index([status, nextRetryAt, createdAt])
  // Zombie recovery: PROCESSING jobs older than N minutes
  @@index([status, evaluationStartedAt])
}

model UserContextInput {
  id               String   @id @default(uuid())
  userId           String
  rawInput         String
  parsedIntent     String?
  extractedTopics  Json?
  extractedQuestions Json?
  createdAt        DateTime @default(now())
  deletedAt        DateTime?

  user             User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}