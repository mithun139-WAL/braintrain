# Backend Environment Variables
# Copy this file to .env.development (local) or .env.production (production)
# and fill in the values. Never commit the actual .env files.

# Server
PORT=3000

# Database
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<dbname>

# Auth
JWT_SECRET=<your-strong-jwt-secret>

# Google OAuth (optional)
GOOGLE_CLIENT_ID=<your-google-client-id>

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMTP (Email OTP - e.g. SendGrid, AWS SES, or Gmail App Passwords)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@braintrain.ai
