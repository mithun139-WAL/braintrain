# ─── API ──────────────────────────────────────────────────────────────────────
# URL of the FastAPI backend.
# NEXT_PUBLIC_ prefix exposes this to the browser bundle (baked in at build time).
# Must be set in your deployment platform (Render, Vercel, etc.) before building.
NEXT_PUBLIC_API_URL=https://your-api-domain.com

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Must match GOOGLE_CLIENT_ID in the API .env
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── LiveKit WebRTC ────────────────────────────────────────────────────────────
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
