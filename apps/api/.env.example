# ─── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
PORT=8000

# ─── Database ──────────────────────────────────────────────────────────────────
# IMPORTANT: Must use the asyncpg driver prefix: postgresql+asyncpg://
# FastAPI uses a separate database from the NestJS backend during migration.
# NestJS continues using: braintrain_dev
# FastAPI uses:           braintrain_api_dev
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/braintrain_api_dev

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080        # 7 days

# ─── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── OpenAI ────────────────────────────────────────────────────────────────────
# Leave unset or empty to use stub providers (offline, zero cost)
OPENAI_API_KEY=

# ─── NVIDIA NIM ────────────────────────────────────────────────────────────────
# NIM takes precedence over OpenAI for evaluation, question gen, and coaching.
# Get your key at: https://build.nvidia.com/
# Leave empty to fall back to OpenAI (if configured) or stub providers.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ─── Groq (audio transcription) ────────────────────────────────────────────────
# Used ONLY for audio/video transcription (Whisper on Groq LPUs).
# LLM tasks (evaluation, question gen, coaching) use NVIDIA NIM above.
# Get your key at: https://console.groq.com/keys
# Leave empty to fall back to OpenAI Whisper-1 (if set) or stub provider.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3

# ─── SMTP (Email OTP) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@braintrain.ai

# ─── Twilio (SMS OTP) ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Stripe Billing ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/dashboard/settings?billing=success
STRIPE_CANCEL_URL=http://localhost:3000/dashboard/settings?billing=cancelled
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/dashboard/settings
PRO_MONTHLY_EVALUATION_CREDIT_LIMIT=100

# ─── LiveKit WebRTC ────────────────────────────────────────────────────────────
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://your-project.livekit.cloud
