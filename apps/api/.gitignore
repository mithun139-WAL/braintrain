# ─── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ─── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env/

# ─── uv / pip ──────────────────────────────────────────────────────────────────
.uv/
*.egg-info/
dist/
build/
*.egg

# ─── Environment files (keep .env.example, ignore actual env files) ────────────
.env
.env.development
.env.production
.env.staging
.env.local
!.env.example

# ─── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# ─── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ─── Alembic (keep versions tracked) ──────────────────────────────────────────
